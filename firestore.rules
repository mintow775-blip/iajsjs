rules_version = '2';
// AR X Mine - Firestore security rules (replaces database.rules.json).
// Roles / suspension / download counters are written ONLY by the Vercel Functions (Admin SDK bypasses these rules), never by the browser.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() { return request.auth != null; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }
    function userPath(uid) { return /databases/$(database)/documents/users/$(uid); }
    function hasUserDoc() { return exists(userPath(request.auth.uid)); }
    function roleOf() { return hasUserDoc() ? get(userPath(request.auth.uid)).data.get('role', 'user') : 'user'; }
    function notSuspended() { return !hasUserDoc() || get(userPath(request.auth.uid)).data.get('suspended', false) != true; }
    // Owner email is admin (no email verification / OTP in this site, same as the old rules). Register that account yourself first.
    function isAdmin() {
      return signedIn() && (request.auth.token.email == 'atarafatyt1@gmail.com' || roleOf() == 'admin');
    }
    function ownsProject(pid) {
      return signedIn() && exists(/databases/$(database)/documents/projects/$(pid))
        && get(/databases/$(database)/documents/projects/$(pid)).data.ownerUid == request.auth.uid;
    }
    function isPublished(pid) { return exists(/databases/$(database)/documents/projectsPublic/$(pid)); }
    function okUrl(v) { return v is string && v.size() <= 500 && (v == '' || v.matches('^https?://[^\\s]+$')); }

    // ---------- users ----------
    function userFieldsOk(d) {
      return (!('username' in d) || (d.username is string && d.username.matches('^[a-z0-9_]{3,20}$')))
        && (!('email' in d) || d.email == request.auth.token.email)
        && (!('createdAt' in d) || d.createdAt is number)
        && (!('displayName' in d) || (d.displayName is string && d.displayName.size() >= 1 && d.displayName.size() <= 40))
        && (!('minecraftUsername' in d) || (d.minecraftUsername is string && d.minecraftUsername.size() <= 32))
        && (!('avatar' in d) || okUrl(d.avatar))
        && (!('bio' in d) || (d.bio is string && d.bio.size() <= 300));
    }
    function userKeys() { return ['username', 'email', 'createdAt', 'displayName', 'minecraftUsername', 'avatar', 'bio']; }

    match /users/{uid} {
      allow get: if isMe(uid) || isAdmin();
      allow list: if isAdmin();
      allow create: if isMe(uid) && notSuspended()
        && request.resource.data.keys().hasAll(['username', 'email', 'createdAt'])
        && request.resource.data.keys().hasOnly(userKeys())
        && userFieldsOk(request.resource.data);
      // username / email / createdAt can be set once; role, suspended, developerStatus are not writable from the browser.
      allow update: if isMe(uid) && notSuspended()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(userKeys())
        && (!('username' in resource.data) || request.resource.data.username == resource.data.username)
        && (!('email' in resource.data) || request.resource.data.email == resource.data.email)
        && (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt)
        && userFieldsOk(request.resource.data);

      match /favorites/{pid} {
        allow read: if isMe(uid);
        allow create, update: if isMe(uid) && notSuspended() && request.resource.data.keys().hasOnly(['v']) && request.resource.data.v == true;
        allow delete: if isMe(uid);
      }
      match /following/{cid} {
        allow read: if isMe(uid);
        allow create, update: if isMe(uid) && notSuspended() && cid != uid && request.resource.data.keys().hasOnly(['v']) && request.resource.data.v == true;
        allow delete: if isMe(uid);
      }
      match /notifications/{nid} {
        allow read: if isMe(uid);
        allow update: if isMe(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']) && request.resource.data.read is bool;
        allow delete: if isMe(uid);
      }
      match /downloads/{id} {
        allow read: if isMe(uid);
      }
    }

    match /usernames/{name} {
      allow get: if true;
      allow create: if signedIn() && notSuspended() && name.matches('^[a-z0-9_]{3,20}$')
        && request.resource.data.keys().hasOnly(['uid']) && request.resource.data.uid == request.auth.uid;
    }

    match /publicProfiles/{uid} {
      allow read: if true;
      allow create, update: if isMe(uid) && notSuspended()
        && request.resource.data.keys().hasAll(['username'])
        && request.resource.data.keys().hasOnly(['username', 'displayName', 'minecraftUsername', 'avatar'])
        && request.resource.data.username is string && request.resource.data.username.matches('^[a-z0-9_]{3,20}$')
        && (!('displayName' in request.resource.data) || (request.resource.data.displayName is string && request.resource.data.displayName.size() >= 1 && request.resource.data.displayName.size() <= 40))
        && (!('minecraftUsername' in request.resource.data) || (request.resource.data.minecraftUsername is string && request.resource.data.minecraftUsername.size() <= 32))
        && (!('avatar' in request.resource.data) || okUrl(request.resource.data.avatar));
    }

    match /developerApplications/{uid} {
      allow get: if isMe(uid) || isAdmin();
      allow list: if isAdmin();
      allow create, update: if isMe(uid) && notSuspended()
        && (request.method == 'create' || resource.data.status != 'approved')
        && request.resource.data.keys().hasAll(['name', 'pitch', 'status', 'createdAt'])
        && request.resource.data.keys().hasOnly(['name', 'pitch', 'links', 'status', 'createdAt'])
        && request.resource.data.status == 'pending'
        && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 60
        && request.resource.data.pitch is string && request.resource.data.pitch.size() >= 1 && request.resource.data.pitch.size() <= 1000
        && (!('links' in request.resource.data) || (request.resource.data.links is string && request.resource.data.links.size() <= 500))
        && request.resource.data.createdAt is number;
    }

    // ---------- site content (public read, admin write) ----------
    match /site/{doc} {
      allow read: if true;
      allow write: if isAdmin() && notSuspended();
    }
    match /banners/{id} {
      allow read: if true;
      allow write: if isAdmin() && notSuspended();
    }
    match /socials/{id} {
      allow read: if true;
      allow delete: if isAdmin() && notSuspended();
      allow create, update: if isAdmin() && notSuspended()
        && request.resource.data.url is string && request.resource.data.url.matches('^(https?://|mailto:)[^\\s]+$');
    }
    match /catalogCategories/{id} {
      allow read: if true;
      allow write: if isAdmin() && notSuspended();
    }
    match /catalogPlatforms/{id} {
      allow read: if true;
      allow write: if isAdmin() && notSuspended();
    }
    match /catalogMcVersions/{id} {
      allow read: if true;
      allow write: if isAdmin() && notSuspended();
    }

    // ---------- projects ----------
    function projectOk(d) {
      return d.name is string && d.name.size() >= 3 && d.name.size() <= 80
        && d.ownerUid is string && d.category is string && d.category.size() >= 1 && d.category.size() <= 60
        && d.edition in ['java', 'bedrock'] && d.status is string && d.updatedAt is number
        && (!('description' in d) || (d.description is string && d.description.size() <= 400))
        && (!('readme' in d) || (d.readme is string && d.readme.size() <= 20000))
        && (!('icon' in d) || okUrl(d.icon)) && (!('banner' in d) || okUrl(d.banner));
    }
    match /projects/{pid} {
      allow get: if signedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow list: if signedIn() && (isAdmin() || resource.data.ownerUid == request.auth.uid);
      allow create: if signedIn() && notSuspended() && projectOk(request.resource.data)
        && (isAdmin() || (roleOf() in ['developer', 'admin'] && request.resource.data.ownerUid == request.auth.uid
            && request.resource.data.status in ['draft', 'pending']));
      allow update: if signedIn() && notSuspended() && projectOk(request.resource.data)
        && (isAdmin() || (resource.data.ownerUid == request.auth.uid && request.resource.data.ownerUid == resource.data.ownerUid
            && request.resource.data.status in ['draft', 'pending']));
      allow delete: if signedIn() && notSuspended() && (isAdmin() || resource.data.ownerUid == request.auth.uid);
    }
    match /projectsPublic/{pid} {
      allow read: if true;
      // Approve = admin copies the project here. Owners may only take their own project down. Download counters are written by the server.
      allow create, update: if isAdmin() && notSuspended();
      allow delete: if signedIn() && (isAdmin() || ownsProject(pid));
    }
    match /projectVersions/{pid}/items/{vid} {
      allow read: if isPublished(pid) || (signedIn() && (ownsProject(pid) || isAdmin()));
      allow create, update: if signedIn() && notSuspended() && (isAdmin() || ownsProject(pid))
        && request.resource.data.keys().hasAll(['version', 'mc', 'platforms', 'createdAt'])
        && request.resource.data.keys().hasOnly(['version', 'changelog', 'mc', 'platforms', 'createdAt'])
        && request.resource.data.version is string && request.resource.data.version.size() >= 1 && request.resource.data.version.size() <= 40
        && (!('changelog' in request.resource.data) || (request.resource.data.changelog is string && request.resource.data.changelog.size() <= 5000))
        && request.resource.data.mc is map && request.resource.data.platforms is map && request.resource.data.createdAt is number;
      allow delete: if signedIn() && notSuspended() && (isAdmin() || ownsProject(pid));
    }
    // File records are created/removed only by the server (upload-finalize / file-delete). Downloads go through /api/download.
    match /projectFiles/{pid}/versions/{vid}/files/{fid} {
      allow read: if signedIn() && (isPublished(pid) || ownsProject(pid) || isAdmin());
    }

    // ---------- community ----------
    match /reviews/{pid}/items/{uid} {
      allow read: if true;
      allow create, update: if (isAdmin() || (isMe(uid) && notSuspended() && isPublished(pid)))
        && request.resource.data.keys().hasAll(['stars', 'text', 'createdAt'])
        && request.resource.data.keys().hasOnly(['stars', 'text', 'userName', 'createdAt', 'updatedAt'])
        && request.resource.data.stars is number && request.resource.data.stars >= 1 && request.resource.data.stars <= 5
        && request.resource.data.text is string && request.resource.data.text.size() <= 2000
        && (!('userName' in request.resource.data) || (request.resource.data.userName is string && request.resource.data.userName.size() <= 40));
      allow delete: if isAdmin() || (isMe(uid) && notSuspended());
    }
    // Doc id = {reviewAuthorUid}__{voterUid}
    match /reviewVotes/{pid}/items/{vid} {
      allow read: if true;
      allow create, update: if signedIn() && notSuspended()
        && request.resource.data.keys().hasOnly(['ruid', 'voter', 'helpful'])
        && request.resource.data.voter == request.auth.uid && request.resource.data.ruid != request.auth.uid
        && request.resource.data.helpful is bool
        && vid == request.resource.data.ruid + '__' + request.auth.uid;
      allow delete: if signedIn() && resource.data.voter == request.auth.uid;
    }
    match /comments/{pid}/items/{cid} {
      allow read: if true;
      allow create: if signedIn() && notSuspended()
        && request.resource.data.keys().hasAll(['uid', 'text', 'createdAt'])
        && request.resource.data.keys().hasOnly(['uid', 'userName', 'text', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 1000
        && (!('userName' in request.resource.data) || (request.resource.data.userName is string && request.resource.data.userName.size() <= 40))
        && request.resource.data.createdAt is number;
      allow delete: if signedIn() && notSuspended() && (resource.data.uid == request.auth.uid || isAdmin() || ownsProject(pid));
    }
    match /reports/{rid} {
      allow read, update, delete: if isAdmin();
      allow create: if signedIn() && notSuspended()
        && request.resource.data.keys().hasAll(['type', 'target', 'reason', 'by', 'createdAt'])
        && request.resource.data.keys().hasOnly(['type', 'target', 'reason', 'by', 'createdAt', 'status'])
        && request.resource.data.type in ['project', 'review', 'comment', 'user']
        && request.resource.data.target is string && request.resource.data.target.size() >= 1 && request.resource.data.target.size() <= 200
        && request.resource.data.reason is string && request.resource.data.reason.size() >= 1 && request.resource.data.reason.size() <= 500
        && request.resource.data.by == request.auth.uid;
    }

    // Upload progress written by the server, polled by the uploader.
    match /uploads/{uid}/items/{id} {
      allow read: if isMe(uid);
    }

    // Everything else is closed.
    match /{document=**} { allow read, write: if false; }
  }
}
